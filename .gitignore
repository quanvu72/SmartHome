# .gitignore cho Smart Home IoT Project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/*.log
*.log

# Images (tùy chọn - có thể bỏ comment nếu không muốn commit ảnh)
images/*.jpg
images/*.jpeg
images/*.png

# Config files với thông tin nhạy cảm (nếu có)
# config.local.json
# secrets.json
users.json

# OS
Thumbs.db
.DS_Store

# Raspberry Pi specific
*.img
*.zip

# Temporary files
*.tmp
*.bak
*.swp
